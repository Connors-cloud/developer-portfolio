---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Home">
  <section aria-labelledby="intro-heading" class="max-w-3xl">
    <p class="eyebrow">A space for work & ideas</p>
    <h1 id="intro-heading" class="page-title">Hello, I’m <span class="text-accent">{profile.name}.</span></h1>
    <p class="page-description">{profile.introduction}</p>
    <p class="text-muted mt-6 max-w-2xl">This is the beginning of my developer portfolio and technical journal. Projects, learning milestones, and technical writing will find a home here.</p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/projects/" class="button-primary">Explore projects <span aria-hidden="true">↗</span></a>
      <a href="/journal/" class="button-secondary">Visit the journal <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <aside class="mt-20 border-t border-line pt-6 text-sm text-muted" aria-label="Site status">
    <span class="status-dot" aria-hidden="true"></span> A work in progress. Personal details and content are placeholders.
  </aside>
</BaseLayout>
