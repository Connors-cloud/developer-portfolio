---
import { navigation } from '../../data/navigation';
import { profile } from '../../data/profile';
import ThemeToggle from '../ui/ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="site-shell py-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="brand" aria-label={`${profile.siteTitle} — home`}>
        <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
        <span class="max-w-48 text-balance">{profile.siteTitle}</span>
      </a>
      <ThemeToggle />
    </div>
    <nav aria-label="Main navigation" class="mt-6">
      <ul class="flex flex-wrap gap-x-1 gap-y-2">
        {navigation.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="nav-link"
              aria-current={pathname === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
