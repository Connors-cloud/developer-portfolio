---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'Coming soon' } = Astro.props;
---

<header class="max-w-3xl">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title">{title}</h1>
  <p class="page-description">{description}</p>
</header>
